rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "none";
    }
    function isSuperAdmin() { return myRole() == "admin"; }
    function isStaff()      { return myRole() == "admin" || myRole() == "faculty"; }
    function isSelf(uid)    { return signedIn() && request.auth.uid == uid; }

    // ---------- users ----------
    match /users/{uid} {
      // staff need to read the student list (for exam assignment); a user can read self
      allow read: if isSelf(uid) || isStaff();
      // Super-admins manage all accounts. A newly signed-up user may create their
      // OWN profile, but only as a plain student tied to their own auth email —
      // self-signup can never mint an admin/faculty account.
      allow create: if isSuperAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == "student"
          && request.resource.data.email == request.auth.token.email);
      allow update, delete: if isSuperAdmin();
    }

    // ---------- questions ----------
    match /questions/{questionId} {
      allow read: if signedIn();                 // students load questions during the exam
      // staff create their own; only the owner or a super-admin can edit/delete
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin() ||
        (isStaff() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- exams ----------
    match /exams/{examId} {
      allow read: if signedIn();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin() ||
        (isStaff() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- attempts ----------
    match /attempts/{attemptId} {
      // signed-in users may read attempts (needed for client-side rank/percentile).
      // Tighten to own + staff if score privacy matters more than client percentile.
      allow read: if signedIn();
      // a student creates/updates only their own attempt
      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update: if isStaff() ||
        (signedIn() && resource.data.studentUid == request.auth.uid
                    && request.resource.data.studentUid == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---------- topicIndex (lightweight chapter index for student practice) ----------
    // One small doc per examType+subject listing {id, topic, difficulty, section} so a
    // student can browse chapters without downloading the whole image-heavy question bank.
    match /topicIndex/{indexId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---------- practiceAttempts (student self-study, ungraded) ----------
    // Deliberately separate from /attempts so practice never touches Reports,
    // Leaderboard, Item Analysis, rank or percentile.
    match /practiceAttempts/{practiceId} {
      // a student sees only their own; staff can review all
      allow read: if isStaff() ||
        (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update: if signedIn() && resource.data.studentUid == request.auth.uid
                    && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isStaff();
    }

    // ---------- sessions (single active device per account) ----------
    match /sessions/{uid} {
      allow read, write: if isSelf(uid);
    }

    // deny everything else
    match /{document=**} { allow read, write: if false; }
  }
}
